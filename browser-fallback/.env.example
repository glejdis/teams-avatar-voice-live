# Voice Live / Foundry
AZURE_TENANT_ID=<TENANT_ID>
AZURE_VOICELIVE_ENDPOINT=https://<FOUNDRY_ACCOUNT_NAME>.cognitiveservices.azure.com
AZURE_VOICELIVE_API_VERSION=2026-01-01-preview
AZURE_VOICELIVE_VOICE=en-US-AvaMultilingualNeural

# Agent mode is preferred when the hosted agent is healthy.
# Leave version blank to use the current/default version.
AGENT_FOUNDRY_AGENT_NAME=lisa
AGENT_FOUNDRY_PROJECT_NAME=<foundry-project-name>
# AGENT_FOUNDRY_AGENT_VERSION=
TEAMS_JOIN_MODE=browser_webrtc

# If agent mode is not configured, this direct-model fallback is used.
AZURE_VOICELIVE_MODEL=gpt-realtime-1.5
AGENT_DEMO_INSTRUCTIONS=You are a friendly assistant. Keep answers short, natural, and spoken. Ask one question at a time. Do not read markdown.

# Avatar
AVATAR_CHARACTER=lisa
AVATAR_STYLE=casual-sitting
AVATAR_VIDEO_WIDTH=1280
AVATAR_VIDEO_HEIGHT=720
AVATAR_VIDEO_BITRATE=1500000
AVATAR_VIDEO_GOP_SIZE=30
AVATAR_CHROMA_ENABLED=true
AVATAR_CHROMA_COLOR="#00ff00"
TEAMS_AVATAR_BACKGROUND_IMAGE=/background.png
# Optional direct Voice Live avatar background. Set EITHER a public HTTPS image
# URL (preferred) OR a hex color — image takes precedence if both are set.
# Local / localhost URLs are only for the canvas chroma-key overlay, not for
# Voice Live (which fetches the URL server-side).
# AVATAR_BACKGROUND_IMAGE_URL=https://<public-host>/background.png
# AVATAR_BACKGROUND_COLOR="#FFFFFFFF"

# Voice Live tuning (server-side VAD + sampling temperature).
# VOICELIVE_VAD_THRESHOLD=0.5
# VOICELIVE_VAD_PREFIX_PADDING_MS=150
# VOICELIVE_VAD_SILENCE_DURATION_MS=350
# VOICELIVE_TEMPERATURE=0.7

# Local browser-demo housekeeping (optional). Paths default to browser-fallback/data/.
# BROWSER_DEMO_RESET_ON_START=false
# BROWSER_DEMO_AUTO_JOIN_LOG_PATH=
# BROWSER_DEMO_CLIENT_LOG_PATH=
# BROWSER_DEMO_TRANSCRIPTS_PATH=

# Azure Communication Services browser Teams join.
# Prefer the connection string for the two-day demo, because it avoids extra RBAC friction.
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://<acs-resource>.communication.azure.com/;accesskey=<key>
# Or use Entra auth instead:
# AZURE_COMMUNICATION_ENDPOINT=https://<acs-resource>.communication.azure.com/

# Prefill UI only; can be pasted in the browser too.
TEAMS_MEETING_LINK=
TEAMS_DISPLAY_NAME=Lisa
DEMO_LATEST_INVITE_PATH=browser-fallback/data/latest-invite.json
