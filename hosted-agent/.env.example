# Local dev: copy to .env and fill in.
# In production (Foundry hosted agent) these are injected automatically by
# the agent runtime — you do NOT need a .env file inside the container.

# ── Required ─────────────────────────────────────────────────────────────
# Foundry project endpoint that hosts the model deployment the agent uses.
# Form: https://<foundry-resource>.services.ai.azure.com/api/projects/<project>
AGENT_FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>

# ── Optional ─────────────────────────────────────────────────────────────
# Model deployment name in the project (default: gpt-4.1-mini).
AGENT_FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
AGENT_AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Persona file (Markdown) loaded by instructions.py at startup.
# Relative paths are resolved against hosted-agent/. See personas/README.md
# for authoring guidance. Default: personas/lisa.md (the shipped example).
# PERSONA_FILE=personas/lisa.md

# Pin to a specific user-assigned Managed Identity (only when running inside
# Azure with multiple MIs assigned). Leave empty to use DefaultAzureCredential.
# AZURE_CLIENT_ID=

# Log verbosity (DEBUG / INFO / WARNING).
LOG_LEVEL=INFO
