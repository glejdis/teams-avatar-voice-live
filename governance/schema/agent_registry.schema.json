{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/glejdis/teams-avatar-voice-live/schemas/agent-registry.schema.json",
  "title": "teams-avatar-voice-live Agent Registry",
  "description": "Declarative registry of governed agent identities. Authoritative validation is governance/validate_registry.py; this schema is for editor / documentation support.",
  "type": "object",
  "required": ["version", "agents"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "defaults": { "type": "object" },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/agent" }
    }
  },
  "definitions": {
    "agent": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "app",
        "owner",
        "purpose",
        "data",
        "entra",
        "least_privilege",
        "lifecycle",
        "human_oversight"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "display_name": { "type": "string", "minLength": 1 },
        "app": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string" },
        "code_name": { "type": "string" },
        "owner": { "type": "string", "minLength": 1 },
        "business_owner": { "type": "string" },
        "purpose": { "type": "string", "minLength": 1 },
        "human_oversight": { "type": "string", "minLength": 1 },
        "co_determination": {
          "type": "string",
          "enum": ["required", "obtained", "not_required"]
        },
        "lifecycle": {
          "type": "string",
          "enum": ["proposed", "active", "retired"]
        },
        "related_issue": { "type": "string" },
        "sub_agents": { "type": "array", "items": { "type": "string" } },
        "access": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "conditional_access": { "type": "string", "minLength": 1 },
            "sensitive_data_groups": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1
              }
            }
          }
        },
        "data": {
          "type": "object",
          "required": ["personal_data", "special_category", "employment_decision", "sensitivity"],
          "properties": {
            "personal_data": { "type": "boolean" },
            "special_category": { "type": "boolean" },
            "employment_decision": { "type": "boolean" },
            "sensitivity": {
              "type": "string",
              "enum": ["public", "internal", "confidential", "restricted"]
            }
          }
        },
        "entra": {
          "type": "object",
          "required": ["identity_name", "identity_type", "status"],
          "properties": {
            "identity_name": { "type": "string", "minLength": 1 },
            "identity_type": {
              "type": "string",
              "enum": ["user-assigned-managed-identity", "entra-agent-id"]
            },
            "status": {
              "type": "string",
              "enum": ["planned", "provisioned", "retired"]
            }
          }
        },
        "least_privilege": {
          "type": "object",
          "required": ["graph_scopes"],
          "properties": {
            "graph_scopes": { "type": "array", "items": { "type": "string" } },
            "azure_roles": { "type": "array", "items": { "type": "string" } },
            "data_scopes": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
