# Root environment template for the `launcher` CLI / web service.
# Copy to `.env` and edit:    cp .env.example .env
#
# Note: `hosted-agent/` and `browser-fallback/` have their own .env.example
# files for their respective runtimes — this file covers ONLY the launcher.

# ── Microsoft Graph (Teams meeting + invite email) ──────────────────────────
# Required for `launcher schedule` to create meetings and send invite emails.
# Get GRAPH_ONLINE_MEETING_ORGANIZER_USER_ID from Azure portal → Entra ID →
# Users → <organiser> → Object ID. The organiser mailbox must be licensed.
GRAPH_CLIENT_ID=<entra-app-client-id>
GRAPH_CLIENT_SECRET=<entra-app-secret>
GRAPH_TENANT_ID=<tenant-id>
GRAPH_ONLINE_MEETING_ORGANIZER_USER_ID=<organiser-object-id>
# GRAPH_ORGANIZER_UPN=organiser@yourdomain.com   # optional — auto-resolves USER_ID

# ── Branding ────────────────────────────────────────────────────────────────
# Brand label woven into the invite email subject + body. Falls back to
# "Contoso" if unset, so a fresh clone produces sensible-looking output.
# BRAND_NAME=Contoso

# ── Avatar transport selector ───────────────────────────────────────────────
# graph_bot     — production VMSS Microsoft Graph calling bot (default)
# browser_webrtc — local-dev fallback via browser-fallback/ ACS WebRTC UI
TEAMS_JOIN_MODE=graph_bot

# ── graph_bot transport (production, VMSS) ──────────────────────────────────
# Where launcher.bot_dispatcher POSTs the join URL.
# BOT_JOIN_ENDPOINT=https://<BOT_FQDN>/joinCall
# BOT_DISPLAY_NAME=Lisa                          # roster name shown in Teams
# BOT_AUTH_SHARED_SECRET=<shared-secret>         # X-Bot-Auth header value
# BOT_JOIN_REQUIRED=false                        # if true, fail loudly on bot errors

# ── browser_webrtc transport (local dev / fallback) ─────────────────────────
# JSON file written by bot_dispatcher; polled by browser-fallback/static UI.
# DEMO_LATEST_INVITE_PATH=browser-fallback/data/latest-invite.json

# ── Foundry / hosted agent (only when launcher needs to talk to Foundry) ────
# AGENT_FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>
# AGENT_FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
# AZURE_TENANT_ID=<tenant-id>

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
